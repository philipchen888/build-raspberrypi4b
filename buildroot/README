Build buildroot sdcard image for raspberrypi4b:

wget https://buildroot.org/downloads/buildroot-2026.05.tar.xz
tar -xJf buildroot-2026.05.tar.xz
mv buildroot-2026.05 buildroot

vi ./buildroot/configs/raspberrypi4_64_defconfig ( delete KERNEL, delete BR2_DOWNLOAD_FORCE_CHECK_HASHES=y, BR2_GLOBAL_PATCH_DIR, append ./patches/rpi4b_defconfig )
cp ./patches/raspberrypi4/config_4.txt ./buildroot/board/raspberrypi4-64/
cp ./patches/raspberrypi4/cmdline_4.txt ./buildroot/board/raspberrypi4-64/
cp ./patches/raspberrypi4/cmdline_4.txt ./buildroot/board/raspberrypi/cmdline.txt

sudo update-alternatives --install /usr/bin/install install /usr/bin/gnuinstall 100
cd buildroot
\rm -rf .config output
make clean
make raspberrypi4_64_defconfig
make linux
make

The result is in ./output/images/sdcard.img

Plugin sdcard to PC.
sudo dd if=./output/images/sdcard.img of=/dev/sda bs=4096 conv=notrunc,fsync

sudo mount /dev/sda2 /mnt
sudo vi /mnt/etc/network/interfaces ( delete everything after iface lo inet loopback )
sudo vi /mnt/etc/vsftpd.conf ( anonymous_enable=NO, local_enable=YES, write_enable=YES )
sync; sudo umount /mnt;
Eject sdcard from PC.

plugin sdcard to rpi4b.
login:
username: root
password: linaro

uname -a

adduser linaro

wpa_passphrase your_SSID your_passphrase > /etc/ssid.conf ( delete password in ssid.conf )
wpa_supplicant -B -i wlan0 -c /etc/ssid.conf
dhcpcd wlan0
ifconfig

ssh root@192.168.86.21

date
aplay -l

aplay /home/linaro/yoursong.wav
mpv /home/linaro/yoursong.mp3

bluetoothctl list
hciconfig hci0
hcitool dev
hciconfig -a
