Compile vendor's kernel:

Install ovmerge from  https://github.com/raspberrypi/utils
sudo apt install cmake libfdt-dev
git clone https://github.com/raspberrypi/utils.git
cd utils
cmake .
make
sudo make install
which ovmerge

git clone https://github.com/raspberrypi/linux --depth=1 -b rpi-7.2.y

vi ./linux/arch/arm64/configs/bcm2711_defconfig ( delete CONFIG_CMDLINE, change CONFIG_I2C_CHARDEV=m to CONFIG_I2C_CHARDEV=y )
cd ./linux/arch/arm/boot/dts/broadcom
cp bcm2711-rpi-4-b.dts bcm2711-rpi-4-b.dts.org
cp bcm2711.dtsi bcm2711.dtsi.org
vi bcm2711.dtsi ( change spin-table to psci, add
psci {
	compatible = "arm,psci-1.0", "arm,psci-0.2";
	method = "smc";
};
)
ovmerge -c -p bcm2711-rpi-4-b.dts,i2c1=on,i2c_arm=on,spi=on,audio=on ../overlays/uart2-overlay.dts ../overlays/miniuart-bt-overlay.dts ../overlays/vc4-kms-v3d-pi4-overlay.dts,cma-512 ../overlays/pwm-2chan-overlay.dts,pin=12,func=4,pin2=13,func2=4 > custom.dts
cp custom.dts bcm2711-rpi-4-b.dts
cd ../../../../../../

make kernel
